{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quanah Cube",
  "version": "0.1.0",
  "identifier": "com.quanah.cube",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Quanah Cube",
      "width": 820,
      "height": 720,
      "minWidth": 460,
      "minHeight": 550
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
